# Copy this file to .env and fill in values from your own services.
# Do not put real credentials in this example file.
# The React app must not receive LIVEKIT_API_KEY or LIVEKIT_API_SECRET.

PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/atrium
CLIENT_ORIGIN=http://localhost:5173

# Localhost works over HTTP. To open the app from a machine IP, generate trusted files at
# certs/dev-key.pem and certs/dev-cert.pem, then use the HTTPS address for both origins.
PUBLIC_APP_ORIGIN=http://localhost:5173

# Public WebSocket URL of your LiveKit server. This is not an API secret.
# Leave all three LiveKit values empty until a server is running.
# Use wss:// when the page is served with https.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Set this to the host machine's LAN IP when other devices will join the local LiveKit server.
LIVEKIT_NODE_IP=127.0.0.1

# Optional public API origin for a production frontend build.
# Leave unset in local development. The Vite dev server proxies /api.
# VITE_API_BASE_URL=https://api.example.com
